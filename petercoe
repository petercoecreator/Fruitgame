local function makeButton(parent, text, color, size, position)
	local btn = new("TextButton", {
		Text = text,
		Font = Enum.Font.GothamBlack,
		TextScaled = true,
		TextColor3 = COLORS.white,
		BackgroundColor3 = color,
		AutoButtonColor = false,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = size,
		Position = position,
		BorderSizePixel = 0,
		ZIndex = 30,
	}, parent)
	round(btn, UDim.new(0, 14))
	stroke(btn, Color3.fromRGB(255, 255, 255), 2, 0.6)
	new("UITextSizeConstraint", { MaxTextSize = 26, MinTextSize = 10 }, btn)
	new("UIPadding", {
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
		PaddingTop = UDim.new(0, 6),
		PaddingBottom = UDim.new(0, 6),
	}, btn)
	local scale = new("UIScale", { Scale = 1 }, btn)
	connect(btn.MouseEnter, function()
		tween(scale, 0.12, { Scale = 1.06 })
	end)
	connect(btn.MouseLeave, function()
		tween(scale, 0.12, { Scale = 1 })
	end)
	connect(btn.MouseButton1Down, function()
		tween(scale, 0.08, { Scale = 0.95 })
	end)
	connect(btn.MouseButton1Up, function()
		tween(scale, 0.1, { Scale = 1.06 })
	end)
	return btn
end

