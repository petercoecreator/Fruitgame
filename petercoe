local function allGuiParents()
	local list = {}
	if type(gethui) == "function" then
		local ok, h = pcall(gethui)
		if ok and typeof(h) == "Instance" then
			list[#list + 1] = h
		end
	end
	if CoreGui then
		list[#list + 1] = CoreGui
	end
	local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if pg then
		list[#list + 1] = pg
	end
	return list
end

local function purgeOld()
	for _, parent in ipairs(allGuiParents()) do
		pcall(function()
			for _, child in ipairs(parent:GetChildren()) do
				if child.Name == CONFIG.GuiName then
					child:Destroy()
				end
			end
		end)
	end
	pcall(function()
		for _, child in ipairs(SoundService:GetChildren()) do
			if string.sub(child.Name, 1, #CONFIG.SoundPrefix) == CONFIG.SoundPrefix then
				child:Destroy()
			end
		end
	end)
end
