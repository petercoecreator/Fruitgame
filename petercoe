local function createSound(name, id, volume, looped)
	local ok, sound = pcall(function()
		local s = Instance.new("Sound")
		s.Name = CONFIG.SoundPrefix .. name
		s.SoundId = id
		s.Volume = volume
		s.Looped = looped or false
		s.Parent = SoundService
		return s
	end)
	if ok then
		return sound
	end
	return nil
end

