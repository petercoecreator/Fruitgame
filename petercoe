		if sfxCatch then
			sfxCatch.Volume = muted and 0 or VOLUMES.catch
		end
		if sfxLose then
			sfxLose.Volume = muted and 0 or VOLUMES.lose
		end
	end)
	muteBtn.Text = muted and "🔇" or "🔊"
end

local function safePlay(sound, restart)
	if not sound then
		return
	end
	pcall(function()
		if restart then
			sound.TimePosition = 0
		end
		sound:Play()
	end)
end

local function safeStop(sound)
	if not sound then
		return
	end
	pcall(function()
		sound:Stop()
	end)
end

-- Pré-carrega sem bloquear o jogo; falhas são ignoradas
task.spawn(function()
	pcall(function()
		local list = {}
		for _, s in ipairs({ music, sfxCatch, sfxLose }) do
			if s then
				list[#list + 1] = s
			end
		end
		if #list > 0 then
			ContentProvider:PreloadAsync(list)
		end
	end)
end)

----------------------------------------------------------------------
-- ESTADO DO JOGO
----------------------------------------------------------------------
local state = "menu" -- "menu" | "playing" | "over" | "destroyed"
local score = 0
local best = tonumber(ENV[BEST_KEY]) or 0
local items = {}
local px, vel = 0, 0
local walkT = 0
local gameTime = 0
local spawnTimer = 0
local lastFruitX, lastFruitTime = 0, -1
local pendingFruitX = nil
local lastWasBomb = false
local keys = {}
local overShownAt = 0
local lastLevel = 1
local actionBound = false

local function levelFromScore(s)
	return math.min(CONFIG.MaxLevel, 1 + math.floor(s / CONFIG.PointsPerLevel))
end

local function difficultyName(level)
	if level <= 2 then
		return "Fácil", COLORS.green
	elseif level <= 5 then
		return "Médio", COLORS.gold
	elseif level <= 9 then
		return "Difícil", COLORS.orange
	end
	return "Insano", COLORS.red
end

local function updateHud()
	scoreValue.Text = tostring(score)
	local lvl = levelFromScore(score)
	local name, color = difficultyName(lvl)
	levelValue.Text = "Nv." .. lvl .. " " .. name
	levelValue.TextColor3 = color
	bestValue.Text = tostring(best)
end

local function playerMaxSpeed(areaW)
	return math.max(420, areaW * 0.9)
end

local function fallSpeed(areaH)
	return areaH * math.min(1.05, 0.42 + score * 0.00055)
end

local function spawnInterval()
	return math.max(0.42, 1.25 - score * 0.0008)
end

local function countBombs()
	local n = 0
	for _, it in ipairs(items) do
		if it.kind == "bomb" then
			n = n + 1
		end
	end
	return n
end

local function clearItems()
	for _, it in ipairs(items) do
		safeDestroy(it.gui)
	end
	items = {}
end

local function createItem(kind, x, speed)
	local emoji, pts
	if kind == "bomb" then
		emoji, pts = "💣", 0
	elseif kind == "special" then
		emoji, pts = pick(SPECIALS), CONFIG.SpecialPoints
	else
		emoji, pts = pick(FRUITS), CONFIG.FruitPoints
	end

	local holder = new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(ITEM, ITEM),
		Position = UDim2.fromOffset(x, -ITEM),
		ZIndex = 4,
	}, area)

	local aura
	if kind == "special" then
		aura = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(ITEM + 14, ITEM + 14),
			BackgroundColor3 = COLORS.gold,
			BackgroundTransparency = 0.55,
			BorderSizePixel = 0,
			ZIndex = 1,
		}, holder)
		round(aura, UDim.new(1, 0))
		stroke(aura, COLORS.gold, 2, 0.2)
	elseif kind == "bomb" then
		aura = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(ITEM + 8, ITEM + 8),
			BackgroundColor3 = COLORS.red,
			BackgroundTransparency = 0.7,
			BorderSizePixel = 0,
			ZIndex = 1,
		}, holder)
		round(aura, UDim.new(1, 0))
	end

	new("TextLabel", {
		BackgroundTransparency = 1,
		Text = emoji,
		TextScaled = true,
		Font = Enum.Font.Gotham,
		TextColor3 = COLORS.white,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 2,
	}, holder)

	items[#items + 1] = {
		gui = holder,
		aura = aura,
		kind = kind,
		pts = pts,
		x = x,
		y = -ITEM,
		speed = speed,
		rot = 0,
		rotSpeed = (kind == "bomb") and math.random(-30, 30) or math.random(-120, 120),
	}
end

local function spawnItem(areaW, areaH)
	local maxX = areaW - ITEM
	local maxSpeed = playerMaxSpeed(areaW)
	local interval = spawnInterval()
	local speed = fallSpeed(areaH)

	-- Bomba ocasional: só aparece se existir um espaço seguro fora do caminho do jogador
	local wantBomb = false
	if score >= CONFIG.BombStartScore and not lastWasBomb and countBombs() < CONFIG.MaxBombsOnScreen then
		local chance = math.min(
			CONFIG.BombMaxChance,
			CONFIG.BombBaseChance + (score - CONFIG.BombStartScore) * 0.00015
		)
		wantBomb = math.random() < chance
	end

	if wantBomb then
		local nextDelay = interval * (0.95 + math.random() * 0.2)
		local gap = (gameTime - lastFruitTime) + nextDelay
		local reach = maxSpeed * gap * 0.7 + PW * 0.5
		local lo = math.max(0, lastFruitX - reach)
		local hi = math.min(maxX, lastFruitX + reach)
		local nx = lo + math.random() * (hi - lo)

		local a = math.min(lastFruitX, nx) - PW - ITEM * 0.5
		local b = math.max(lastFruitX, nx) + ITEM + PW
		local options = {}
		if a - ITEM >= 0 then
			options[#options + 1] = { 0, a - ITEM }
		end
		if b <= maxX then
			options[#options + 1] = { b, maxX }
		end

		if #options > 0 then
			local o = options[math.random(#options)]
			local bx = o[1] + math.random() * (o[2] - o[1])
			createItem("bomb", bx, speed)
			pendingFruitX = nx
			spawnTimer = nextDelay
			lastWasBomb = true
			return
		end
	end

	-- Fruta (sempre alcançável a partir da última)
	local x
	if pendingFruitX then
		x = pendingFruitX
		pendingFruitX = nil
	else
		local gap = math.max(0.2, gameTime - lastFruitTime)
		local reach = maxSpeed * gap * 0.7 + PW * 0.5
		local lo = math.max(0, lastFruitX - reach)
		local hi = math.min(maxX, lastFruitX + reach)
		x = lo + math.random() * (hi - lo)
	end
	x = math.clamp(x, 0, maxX)

	local specialChance = math.min(0.18, 0.08 + score * 0.00006)
	local kind = (math.random() < specialChance) and "special" or "fruit"
	createItem(kind, x, speed)

	lastFruitX = x
	lastFruitTime = gameTime
	lastWasBomb = false
	spawnTimer = interval * (0.9 + math.random() * 0.25)
end

----------------------------------------------------------------------
-- CONTROLES
----------------------------------------------------------------------
local ACTION_NAME = "FruitCatcher_Move"
local MOVE_KEYS = {
	Enum.KeyCode.A,
	Enum.KeyCode.D,
	Enum.KeyCode.Left,
	Enum.KeyCode.Right,
}

local function onMoveAction(_, inputState, input)
	if inputState == Enum.UserInputState.Begin then
		keys[input.KeyCode] = true
	else
		keys[input.KeyCode] = nil
	end
	return Enum.ContextActionResult.Sink
end

local function bindMovement()
	if actionBound then
		return
	end
	local ok = pcall(function()
		ContextActionService:BindActionAtPriority(ACTION_NAME, onMoveAction, false, 3000, unpack(MOVE_KEYS))
	end)
	actionBound = ok
end

local function unbindMovement()
	if actionBound then
		pcall(function()
			ContextActionService:UnbindAction(ACTION_NAME)
		end)
		actionBound = false
	end
	keys = {}
end

----------------------------------------------------------------------
-- FLUXO: INICIAR / PERDER
----------------------------------------------------------------------
local function showOverlay(overlay, card, scale)
	overlay.Visible = true
	overlay.BackgroundTransparency = 1
	scale.Scale = 0.7
	tween(overlay, 0.3, { BackgroundTransparency = 0.45 })
	tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
end

local function startGame()
	if state == "playing" or state == "destroyed" then
		return
	end
	clearItems()

	score = 0
	lastLevel = 1
	vel = 0
	walkT = 0
	gameTime = 0
	spawnTimer = 0.7
	pendingFruitX = nil
	lastWasBomb = false
	keys = {}

	local size = area.AbsoluteSize
	px = (size.X - PW) / 2
	lastFruitX = (size.X - ITEM) / 2
	lastFruitTime = -1

	menuOverlay.Visible = false
	overOverlay.Visible = false
	flash.BackgroundTransparency = 1
	player.Rotation = 0

	state = "playing"
	bindMovement()
	updateHud()

	-- Música em loop durante a partida
	safeStop(music)
	safePlay(music, true)
end

local function lose(reason, x, y)
	if state ~= "playing" then
		return
	end
	state = "over"
	unbindMovement()

	local newRecord = false
	if score > best then
		best = score
		newRecord = true
		ENV[BEST_KEY] = best
	end
	updateHud()

	-- Para a música e toca o som de derrota uma única vez
	safeStop(music)
	safeStop(sfxLose)
	safePlay(sfxLose, true)

	-- Efeitos
	flash.BackgroundTransparency = 0.45
	tween(flash, 0.6, { BackgroundTransparency = 1 })
	burst("💥", x or 0, y or 0)

	overReason.Text = (reason == "bomb") and "💣 Você tocou numa bomba!" or "🍎 Uma fruta caiu no chão!"
	overScore.Text = tostring(score)
	overBest.Text = newRecord and "🏆 NOVO RECORDE!" or ("Recorde: " .. best)
	overShownAt = os.clock()
	showOverlay(overOverlay, overCard, overScale)
end

local function catchItem(it, index, py)
	if it.kind == "bomb" then
		lose("bomb", it.x + ITEM / 2, it.y + ITEM / 2)
		return
	end

	score = score + it.pts
	table.remove(items, index)
	safeDestroy(it.gui)

	local special = it.kind == "special"
	popText(
		"+" .. it.pts,
		it.x + ITEM / 2,
		it.y,
		special and COLORS.gold or COLORS.white,
		special and 30 or 22,
		0.7,
		55
	)
	if special then
		burst("✨", it.x + ITEM / 2, it.y + ITEM / 2)
	end

	-- Som de coleta
	safePlay(sfxCatch, true)

	-- Animações
	playerScale.Scale = 1.12
	tween(playerScale, 0.2, { Scale = 1 }, Enum.EasingStyle.Back)
	bump(scoreScale)

	local lvl = levelFromScore(score)
	if lvl > lastLevel then
		lastLevel = lvl
		bump(levelScale)
		local size = area.AbsoluteSize
		popText("NÍVEL " .. lvl .. "!", size.X / 2, size.Y * 0.3, COLORS.gold, 34, 1.1, 40)
	end
	updateHud()
end

----------------------------------------------------------------------
-- LOOP PRINCIPAL
----------------------------------------------------------------------
local function animateClouds(dt, areaW)
	for _, c in ipairs(clouds) do
		c.x = c.x + c.speed * dt
		if c.x > areaW + 20 then
			c.x = -c.w - 20
		end
		c.gui.Position = UDim2.fromOffset(c.x, c.y)
	end
end

local function onFrame(dt)
	dt = math.min(dt, 0.05)
	local size = area.AbsoluteSize
	local areaW, areaH = size.X, size.Y
	if areaW < 50 or areaH < 50 then
		return
	end

	animateClouds(dt, areaW)

	if state ~= "playing" then
		return
	end

	gameTime = gameTime + dt
	local groundTop = areaH - GROUND_H
	local py = groundTop - PH + 6

	-- Movimento suave do jogador
	local dir = 0
	if keys[Enum.KeyCode.A] or keys[Enum.KeyCode.Left] then
		dir = dir - 1
	end
	if keys[Enum.KeyCode.D] or keys[Enum.KeyCode.Right] then
		dir = dir + 1
	end
	local maxSpeed = playerMaxSpeed(areaW)
	vel = vel + (dir * maxSpeed - vel) * math.min(1, dt * 11)
	px = px + vel * dt
	if px < 0 then
		px = 0
		if vel < 0 then
			vel = 0
		end
	elseif px > areaW - PW then
		px = areaW - PW
		if vel > 0 then
			vel = 0
		end
	end
	player.Position = UDim2.fromOffset(px, py)

	-- Animação do bonequinho
	local ratio = math.clamp(vel / maxSpeed, -1, 1)
	walkT = walkT + dt * 16 * math.abs(ratio)
	local swing = math.sin(walkT) * 5 * math.abs(ratio)
	legL.Position = UDim2.fromOffset(20 + swing, 72)
	legR.Position = UDim2.fromOffset(34 - swing, 72)
	player.Rotation = ratio * 6
	eyeL.Position = UDim2.fromOffset(6 + ratio * 2, 10)
	eyeR.Position = UDim2.fromOffset(16 + ratio * 2, 10)

	-- Surgimento
	spawnTimer = spawnTimer - dt
	if spawnTimer <= 0 then
		spawnItem(areaW, areaH)
	end

	-- Atualiza frutas / bombas
	for i = #items, 1, -1 do
		local it = items[i]
		if state ~= "playing" then
			break
		end
		it.y = it.y + it.speed * dt
		it.rot = it.rot + it.rotSpeed * dt
		it.gui.Position = UDim2.fromOffset(it.x, it.y)
		it.gui.Rotation = it.rot
		if it.kind == "special" and it.aura then
			it.aura.BackgroundTransparency = 0.55 + 0.2 * math.sin(gameTime * 8)
		elseif it.kind == "bomb" and it.aura then
			it.aura.BackgroundTransparency = 0.7 + 0.25 * math.sin(gameTime * 12)
		end

		-- Colisão com o jogador
		if overlaps(it.x + 6, it.y + 6, ITEM - 12, ITEM - 12, px + 4, py, PW - 8, PH) then
			catchItem(it, i, py)
		elseif it.y + ITEM >= groundTop + 4 then
			-- Tocou o chão
			if it.kind == "bomb" then
				table.remove(items, i)
				burst("💨", it.x + ITEM / 2, groundTop - 10)
				safeDestroy(it.gui)
			else
				lose("fruit", it.x + ITEM / 2, groundTop - 10)
			end
		end
	end
end

----------------------------------------------------------------------
-- EVENTOS DE INTERFACE E ENTRADA
----------------------------------------------------------------------
connect(playBtn.Activated, startGame)
connect(againBtn.Activated, startGame)

connect(muteBtn.Activated, function()
	muted = not muted
	applyVolumes()
end)

connect(closeBtn.Activated, function()
	if destroyAll then
		destroyAll()
	end
end)

connect(UserInputService.InputBegan, function(input)
	if input.UserInputType ~= Enum.UserInputType.Keyboard then
		return
	end
	if UserInputService:GetFocusedTextBox() then
		return
	end
	local kc = input.KeyCode
	if kc == Enum.KeyCode.A or kc == Enum.KeyCode.D or kc == Enum.KeyCode.Left or kc == Enum.KeyCode.Right then
		if state == "playing" then
			keys[kc] = true
		end
	elseif kc == Enum.KeyCode.Return or kc == Enum.KeyCode.Space then
		if state == "menu" or (state == "over" and os.clock() - overShownAt > 0.6) then
			startGame()
		end
	end
end)

connect(UserInputService.InputEnded, function(input)
	if input.UserInputType == Enum.UserInputType.Keyboard then
		keys[input.KeyCode] = nil
	end
end)

pcall(function()
	connect(UserInputService.WindowFocusReleased, function()
		keys = {}
	end)
end)

connect(RunService.RenderStepped, function(dt)
	local ok, err = pcall(onFrame, dt)
	if not ok then
		warn("[FruitCatcher] Erro no loop: " .. tostring(err))
	end
end)

----------------------------------------------------------------------
-- DESTRUIÇÃO / REGISTRO DA INSTÂNCIA
----------------------------------------------------------------------
local instanceHandle = {}

destroyAll = function()
	if state == "destroyed" then
		return
	end
	state = "destroyed"
	unbindMovement()
	for _, c in ipairs(connections) do
		pcall(function()
			c:Disconnect()
		end)
	end
	connections = {}
	safeStop(music)
	safeDestroy(music)
	safeDestroy(sfxCatch)
	safeDestroy(sfxLose)
	safeDestroy(gui)
	if ENV[INSTANCE_KEY] == instanceHandle then
		ENV[INSTANCE_KEY] = nil
	end
end

instanceHandle.Destroy = destroyAll
ENV[INSTANCE_KEY] = instanceHandle

